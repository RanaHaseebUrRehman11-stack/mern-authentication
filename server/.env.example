# Server environment configuration (example only — do not put real secrets here)

# MongoDB connection string (MongoDB Atlas or local)
MONGO_URI=mongodb://localhost:27017/vehicle_service_db

# Secret used to sign JWT access tokens (use a long random string in real use)
JWT_SECRET=replace-with-a-long-random-secret

# Server port (defaults to 5000 when omitted)
PORT=5000

# Comma-separated list of allowed frontend origins for CORS
# Example: http://localhost:5173,https://your-app.example.com
CLIENT_ORIGINS=http://localhost:5173

# Initial administrator bootstrap (used only by createAdmin.js)
ADMIN_USERNAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Secure self-service administrator registration (POST /api/auth/register/admin).
# Leave empty to keep administrator registration DISABLED.
# After your initial admin is set up, unset this value (or set
# ADMIN_REGISTRATION_ENABLED=false) to close the registration path.
ADMIN_REGISTRATION_SECRET=
ADMIN_REGISTRATION_ENABLED=true
